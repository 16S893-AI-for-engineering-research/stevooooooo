    </collision>
    <!-- Part sts3215_03a_v1 -->
    <visual>
      <origin xyz="0.0207909 -0.0105745 0.0761817" rpy="-2.20282e-15 2.77556e-17 -1.5708"/>
      <geometry>
        <mesh filename="package://three_arm_cell_description/meshes/so101/sts3215_03a_v1.stl"/>
