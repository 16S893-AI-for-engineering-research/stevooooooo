<?xml version="1.0"?>
<!--
  three_arm_cell: two SO-101 arms, a Rotrics DexArm, a base mount, a custom gripper on
  each SO-101, a camera mount on each SO-101 wrist, a laser camera on the DexArm, and a tube.
  All units are meters and radians. Mesh paths are relative to this file.
  See README.md for credits and licenses.
-->
<robot name="three_arm_cell">

  <material name="3d_printed">
    <color rgba="1.0 0.82 0.12 1.0"/>
  </material>
  <material name="sts3215">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <link name="world"/>

  <joint name="world_to_left" type="fixed">
    <parent link="world"/>
    <child link="left_base"/>
    <origin xyz="-0.135 0.221284 -0.0160414" rpy="0 0 0"/>
  </joint>

  <joint name="world_to_right" type="fixed">
    <parent link="world"/>
    <child link="right_base"/>
    <origin xyz="-0.135 0.403716 -0.0160414" rpy="0 0 0"/>
  </joint>

  <joint name="world_to_dexarm" type="fixed">
    <parent link="world"/>
    <child link="B_Fix"/>
    <origin xyz="-0.113101 0.099435 0.086082" rpy="-1.5707963 0 3.1415927"/>
  </joint>


  <joint name="world_to_baseforreal" type="fixed">
    <parent link="world"/>
    <child link="baseforreal"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="baseforreal">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://three_arm_cell_description/meshes/custom/baseforreal.stl"/>
      </geometry>
      <material name="baseforreal_blue">
        <color rgba="0.36 0.52 0.70 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://three_arm_cell_description/meshes/custom/baseforreal.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="world_to_tube_1" type="fixed">
    <parent link="world"/>
    <child link="tube_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tube_1">
    <visual>
      <origin xyz="-0.007 0.0035 0.002" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://three_arm_cell_description/meshes/custom/tube_1.stl"/>
      </geometry>
      <material name="tube_silver">
        <color rgba="0.74 0.76 0.79 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.007 0.0035 0.002" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://three_arm_cell_description/meshes/custom/tube_1.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- ===== Left SO-101 ===== -->

  <!-- Link base -->
  <link name="left_base">
    <inertial>
      <origin xyz="0.020739 0.00204287 0.065966" rpy="0 0 0"/>
      <mass value="0.147"/>
      <inertia ixx="0.000136117" ixy="4.59787e-07" ixz="9.75275e-08" iyy="0.000114686" iyz="-4.97151e-06" izz="0.000130364"/>
    </inertial>
    <!-- Part base_motor_holder_so101_v1 -->
    <visual>
      <origin xyz="0.0206915 0.0221255 0.0300817" rpy="1.5708 -1.23909e-16 2.33147e-15"/>
      <geometry>
        <mesh filename="package://three_arm_cell_description/meshes/so101/base_motor_holder_so101_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
