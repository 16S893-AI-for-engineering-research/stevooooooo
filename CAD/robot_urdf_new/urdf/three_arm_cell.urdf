      </geometry>
    </collision>
  </link>

  <!-- Link wrist -->
  <link name="left_wrist">
    <inertial>
      <origin xyz="-0.000103312 -0.0386143 0.0281156" rpy="0 0 0"/>
      <mass value="0.079"/>
      <inertia ixx="3.68263e-05" ixy="1.7893e-08" ixz="-5.28128e-08" iyy="2.5391e-05" iyz="3.6412e-06" izz="2.1e-05"/>
    </inertial>
    <!-- Part sts3215_03a_no_horn_v1 -->
    <visual>
      <origin xyz="5.55112e-17 -0.0424 0.0306" rpy="1.5708 1.5708 0"/>
      <geometry>
        <mesh filename="package://three_arm_cell_description/meshes/so101/sts3215_03a_no_horn_v1.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <origin xyz="5.55112e-17 -0.0424 0.0306" rpy="1.5708 1.5708 0"/>
      <geometry>
        <mesh filename="package://three_arm_cell_description/meshes/so101/sts3215_03a_no_horn_v1.stl"/>
      </geometry>
    </collision>
    <!-- Part wrist_roll_pitch_so101_v2 -->
    <visual>
      <origin xyz="0 -0.028 0.0181" rpy="-1.5708 -1.5708 0"/>
      <geometry>
        <mesh filename="package://three_arm_cell_description/meshes/so101/wrist_roll_pitch_so101_v2.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
